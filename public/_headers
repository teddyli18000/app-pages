/*
  Content-Security-Policy: default-src 'none'; style-src 'self'; script-src 'none'; img-src 'self'; font-src 'none'; connect-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests
